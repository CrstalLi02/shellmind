# ShellMind env template: copy to .env and fill in values (.env is gitignored — never commit real secrets)
# Local dev: scripts/dev.sh and the Makefile load the root .env automatically
# Containers: docker compose --env-file .env -f deploy/docker-compose.yml up -d

# ---------- LLM (main agent) ----------
SHELLMIND_AI_BASE_URL=http://127.0.0.1:8777/v1/
SHELLMIND_AI_API_KEY=
SHELLMIND_AI_MODEL=k3

# ---------- LLM (intent, optional; skip LLM intent classification if API key is empty) ----------
SHELLMIND_INTENT_AI_BASE_URL=http://127.0.0.1:8777/v1/
SHELLMIND_INTENT_AI_API_KEY=
SHELLMIND_INTENT_AI_MODEL=k3

# ---------- Security ----------
# Encrypts stored SSH passwords. Keep this the same as the old deploy or historical passwords will not decrypt.
SHELLMIND_SECRET_KEY=

# ---------- Database (dev / prod profiles) ----------
SHELLMIND_DB_URL=jdbc:mysql://127.0.0.1:13306/shellmind?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
SHELLMIND_DB_USERNAME=root
SHELLMIND_DB_PASSWORD=

# ---------- docker compose ----------
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=13306
SERVER_PORT=8091
# Optional registry mirror, e.g. registry.cn-hangzhou.aliyuncs.com/xfg-studio/mysql:8.0.32
MYSQL_IMAGE=mysql:8.0.32
PHPMYADMIN_IMAGE=phpmyadmin:5.2.1

# Baidu AppBuilder AI-search MCP key (optional; only used by docs/examples/agent and integration tests)
BAIDU_APPBUILDER_API_KEY=
